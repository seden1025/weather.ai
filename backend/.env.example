# 로컬 개발: SQLite (설치 불필요). 운영 배포 시 PostgreSQL(+TimescaleDB)로 교체 권장
DATABASE_URL=sqlite:///./weather_ai.db
# 예: DATABASE_URL=postgresql+psycopg2://weather_user:weather_pass@localhost:5432/weather_ai

# 기상자료개방포털 (data.kma.go.kr) 인증키
KMA_API_KEY=

# 카카오 로컬 API (developers.kakao.com) REST API 키 - 주소 검색용
KAKAO_REST_API_KEY=

# 뉴스 조사: 언론사 공개 RSS 사용 (별도 인증키 불필요, app/services/news_client.py 참고)

# CORS 허용 origin (프론트엔드 개발 서버)
FRONTEND_ORIGIN=http://localhost:3000
